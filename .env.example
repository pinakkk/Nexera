# =============================================================================
# Groq API (FREE tier — get key at https://console.groq.com)
# =============================================================================
GROQ_API_KEY=gsk_your_key_here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile
GROQ_AUTO_SELECT_BEST_LLAMA=true

# =============================================================================
# Web Search — Bright Data (primary)
# Get credentials at https://brightdata.com/cp/api_tokens
# =============================================================================
BRIGHTDATA_API_KEY=your_brightdata_key_here
BRIGHTDATA_SERP_ENDPOINT=https://api.brightdata.com/serp
BRIGHTDATA_SCRAPER_ENDPOINT=https://api.brightdata.com/scraping
SEARCH_MAX_RESULTS=5

# =============================================================================
# Web Search — Tavily (fallback, used when BRIGHTDATA_API_KEY is empty)
# Get key at https://tavily.com
# =============================================================================
TAVILY_API_KEY=tvly-your_key_here

# =============================================================================
# Academic APIs (optional — enhances scholarly queries)
# =============================================================================
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_ENDPOINT=https://api.semanticscholar.org/graph/v1
ARXIV_ENDPOINT=https://export.arxiv.org/api

# =============================================================================
# Database (Supabase — managed Postgres + pgvector)
# Get connection string from https://supabase.com → Project Settings → Database
# Use the async driver scheme: postgresql+asyncpg://...
# =============================================================================
# DATABASE_URL: async SQLAlchemy connection string.
# Prefer the Supabase connection pooler (Session mode, port 5432) — the
# direct db.<ref>.supabase.co host is IPv6-only and usually unreachable
# locally. Find it in: Project Settings → Database → Connection string →
# "Connection pooling". Any special chars in the password MUST be
# URL-encoded (e.g. '@' → %40).
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<url_encoded_password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_STARTUP_RETRIES=5
DB_STARTUP_RETRY_DELAY_SECONDS=2
ALLOW_START_WITHOUT_DB=false

# Supabase project (frontend uses the publishable key for auth)
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PASS=your_db_password

# Backend Supabase Auth — verifies user access tokens.
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_AUDIENCE=authenticated
# =============================================================================
# CORS (comma-separated allowed origins)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Rate Limits
# =============================================================================
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_RUNS_PER_MINUTE=5

# =============================================================================
# Agent Behaviour
# =============================================================================
MAX_ITERATIONS=3
MAX_AGENT_ITERS=4
FETCH_TIMEOUT_SECONDS=15
INTEGRATION_CHECK_ON_STARTUP=true
INTEGRATION_CHECK_TIMEOUT_SECONDS=12

# =============================================================================
# Parallel Workers / Cost Guardrails
# =============================================================================
MAX_FETCH_CONCURRENCY=5
MAX_SEARCH_QUERIES_PER_RUN=10
MAX_PAGES_PER_SUBQUESTION=5

# =============================================================================
# Interactive Steering
# =============================================================================
USER_INPUT_TIMEOUT_SECONDS=300

# =============================================================================
# Cohere Rerank (optional)
# =============================================================================
COHERE_API_KEY=

# =============================================================================
# Bright Data Scraping (cost control)
# =============================================================================
RESEARCH_GATE_ENABLED=true

# =============================================================================
# Safety Models
# =============================================================================
MODEL_SAFETY_PROMPT_GUARD=meta-llama/llama-prompt-guard-2-86m
MODEL_SAFETY_CONTENT_GUARD=meta-llama/llama-guard-4-12b

# =============================================================================
# Voice / STT (Whisper)
# =============================================================================
STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_MODEL=whisper-large-v3

# =============================================================================
# PDF Reports
# =============================================================================
REPORTS_DIR=reports

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Supabase Auth (frontend) — Google OAuth
# Enable Google in Supabase: Authentication → Providers → Google
# Add this redirect URL in the Supabase Google provider settings:
#   http://localhost:3000/api/auth/callback
# (Frontend reads NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY above.)
# =============================================================================
