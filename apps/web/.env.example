# =============================================================================
# Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# API backend URL (the FastAPI server)
# The web app has no direct database access — all persistence goes through
# this API, which is backed by Supabase. No DATABASE_URL is needed here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# WorkOS AuthKit Authentication
# Get these from: https://dashboard.workos.com → Applications → your app
# =============================================================================

# Server-side only (never exposed to browser)
WORKOS_API_KEY=sk_test_REPLACE_WITH_YOUR_ACTUAL_KEY
WORKOS_CLIENT_ID=client_REPLACE_WITH_YOUR_CLIENT_ID
WORKOS_COOKIE_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_SECRET_AT_LEAST_32_CHARS

# Redirect URI — MUST match exactly what's configured in WorkOS dashboard
# Local: http://localhost:3000/api/auth/callback
# Production: https://your-domain.vercel.app/api/auth/callback
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
