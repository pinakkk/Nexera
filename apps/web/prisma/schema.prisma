generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Run {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  publicId        String    @unique @default(uuid()) @map("public_id")
  query           String
  constraintsJson Json?     @map("constraints_json")
  status          String
  reportMd        String?   @map("report_md")
  reportJson      Json?     @map("report_json")
  scoresJson      Json?     @map("scores_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  finishedAt      DateTime? @map("finished_at")
  modelName       String?   @map("model_name")
  iterationCount  Int       @default(0) @map("iteration_count")
  events          RunEvent[]

  @@map("runs")
}

model RunEvent {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  externalId  String    @unique @default(uuid()) @map("external_id")
  runId       String    @map("run_id") @db.ObjectId
  timestamp   DateTime  @default(now())
  state       String
  message     String
  payloadJson Json?     @map("payload_json")
  run         Run       @relation(fields: [runId], references: [id])

  @@index([runId], map: "ix_run_events_run_id")
  @@map("run_events")
}
